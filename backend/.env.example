# Kopiere diese Datei nach "backend/.env" und trage deine Werte ein.
# Die Datei .env wird NICHT ins Git-Repository eingecheckt.

# Datenbank (PostgreSQL, z. B. über "docker compose up -d" im Projektordner)
DB_URL=jdbc:postgresql://localhost:5432/battlepedia
DB_USERNAME=battlepedia
DB_PASSWORD=bitte-aendern

# Geheimer Schlüssel für die JWT-Signatur (mindestens 32 Zeichen, zufällig!)
# Erzeugen z. B. mit: openssl rand -base64 48
JWT_SECRET=bitte-durch-einen-langen-zufaelligen-wert-ersetzen
JWT_EXPIRATION_MINUTES=60

# HTTPS: Zertifikat mit ./scripts/create-dev-certificate.sh erzeugen
SSL_ENABLED=true
SSL_KEYSTORE=file:certs/keystore.p12
SSL_KEYSTORE_PASSWORD=bitte-aendern

# Adresse des Frontends (für Links in E-Mails und CORS)
FRONTEND_URL=https://localhost:5173

# Erster Administrator (wird beim Start angelegt, falls noch nicht vorhanden)
ADMIN_EMAIL=admin@battlepedia.local
ADMIN_PASSWORD=bitte-aendern-1!

# E-Mail-Versand: false = Bestätigungslink erscheint nur im Log der Konsole
MAIL_ENABLED=false
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@battlepedia.app
